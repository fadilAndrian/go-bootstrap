# Application
APP_NAME={{.ProjectName}}
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s

{{- if .HasDatabase }}
# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.ProjectName}}?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=15m
DATABASE_SKIP_PING=false
{{- end }}

{{- if .HasWorker }}
# Worker
WORKER_CONCURRENCY=10
{{- end }}

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
